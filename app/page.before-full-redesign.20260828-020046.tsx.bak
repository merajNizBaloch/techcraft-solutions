/* =========================================================
   BALOCHI-INSPIRED GEOMETRIC MOTIF
   ========================================================= */

function BalochiMotif({
  size = 72,
  className = "",
}: {
  size?: number;
  className?: string;
}) {
  return (
    <svg
      width={size}
      height={size}
      viewBox="0 0 100 100"
      fill="none"
      className={className}
      aria-hidden="true"
    >
      <path
        d="M50 5L95 50L50 95L5 50L50 5Z"
        stroke="currentColor"
        strokeWidth="2"
      />

      <path
        d="M50 18L82 50L50 82L18 50L50 18Z"
        stroke="currentColor"
        strokeWidth="1.5"
      />

      <path
        d="M50 31L69 50L50 69L31 50L50 31Z"
        stroke="currentColor"
        strokeWidth="2"
      />

      <path
        d="M50 12V31M50 69V88M12 50H31M69 50H88"
        stroke="currentColor"
        strokeWidth="1.5"
      />

      <path
        d="M50 31L57 43L50 50L43 43L50 31Z"
        fill="currentColor"
        opacity=".12"
      />

      <path
        d="M69 50L57 57L50 50L57 43L69 50Z"
        fill="currentColor"
        opacity=".12"
      />

      <path
        d="M50 69L43 57L50 50L57 57L50 69Z"
        fill="currentColor"
        opacity=".12"
      />

      <path
        d="M31 50L43 43L50 50L43 57L31 50Z"
        fill="currentColor"
        opacity=".12"
      />

      <circle cx="50" cy="50" r="3" fill="#2563FF" />
    </svg>
  );
}

/* =========================================================
   INTERACTIVE PRODUCT VISUAL
   ========================================================= */

function ProductVisual() {
  const ref = useRef<HTMLDivElement>(null);

  useEffect(() => {
    const element = ref.current;
    if (!element) return;

    const move = (event: MouseEvent) => {
      const rect = element.getBoundingClientRect();

      const x = event.clientX - rect.left;
      const y = event.clientY - rect.top;

      const rotateY = (x / rect.width - 0.5) * 5;
      const rotateX = (y / rect.height - 0.5) * -5;

      element.style.transform = `
        perspective(1000px)
        rotateX(${rotateX}deg)
        rotateY(${rotateY}deg)
      `;
    };

    const leave = () => {
      element.style.transform =
        "perspective(1000px) rotateX(0deg) rotateY(0deg)";
    };

    element.addEventListener("mousemove", move);
    element.addEventListener("mouseleave", leave);

    return () => {
      element.removeEventListener("mousemove", move);
      element.removeEventListener("mouseleave", leave);
    };
  }, []);

  return (
    <div ref={ref} className="product-visual">
      <div className="product-window">

        <div className="product-topbar">
          <div className="product-dots">
            <span />
            <span />
            <span />
          </div>

          <span className="product-url">
            techcraft / product
          </span>

          <span className="product-number">
            01
          </span>
        </div>

        <div className="product-content">

          <div className="product-sidebar">
            <div className="sidebar-logo">
              TC
            </div>

            <div className="sidebar-line active" />
            <div className="sidebar-line" />
            <div className="sidebar-line" />
            <div className="sidebar-line" />
          </div>

          <div className="product-main">

            <div className="product-heading">
              <span>PRODUCT</span>
              <strong>EXPERIENCE</strong>
            </div>

            <div className="product-card-grid">

              <div className="mini-card large">
                <span>01</span>
                <div className="mini-chart">
                  <i />
                  <i />
                  <i />
                  <i />
                  <i />
                </div>
              </div>

              <div className="mini-card">
                <BalochiMotif size={48} />
              </div>

              <div className="mini-card blue-card">
                <Sparkles size={18} />
                <span>INTELLIGENCE</span>
              </div>

            </div>

            <div className="product-footer">
              <span>DESIGN</span>
              <span>ENGINEERING</span>
              <span>AI</span>
            </div>

          </div>

        </div>
      </div>
    </div>
  );
}

