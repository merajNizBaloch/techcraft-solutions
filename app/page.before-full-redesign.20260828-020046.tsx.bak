          position: relative;
          grid-row: span 2;
          display: block;
          padding: 13px;
        }

        .mini-card.large > span {
          font-size: 8px;
          color: rgba(17,19,24,.3);
        }

        .mini-chart {
          position: absolute;
          left: 20px;
          right: 20px;
          bottom: 22px;
          height: 65px;
          display: flex;
          align-items: end;
          gap: 7px;
        }

        .mini-chart i {
          flex: 1;
          background: #2563ff;
          opacity: .25;
        }

        .mini-chart i:nth-child(1) {
          height: 25%;
        }

        .mini-chart i:nth-child(2) {
          height: 45%;
        }

        .mini-chart i:nth-child(3) {
          height: 35%;
        }

        .mini-chart i:nth-child(4) {
          height: 70%;
        }

        .mini-chart i:nth-child(5) {
          height: 100%;
          opacity: 1;
        }

        .blue-card {
          flex-direction: column;
          align-items: flex-start;
          justify-content: space-between;
          padding: 15px;
          background: #2563ff;
          color: white;
        }

        .blue-card span {
          font-size: 7px;
          letter-spacing: .12em;
        }

        .product-footer {
          display: flex;
          justify-content: space-between;
          margin-top: 20px;
          padding-top: 13px;
          border-top: 1px solid rgba(17,19,24,.08);
          color: rgba(17,19,24,.35);
          font-size: 7px;
          letter-spacing: .14em;
        }

        .visual-label {
          position: absolute;
          font-size: 8px;
          letter-spacing: .16em;
          color: rgba(17,19,24,.35);
        }

        .top-label {
          top: 45px;
          left: 0;
          display: flex;
          gap: 10px;
        }

        .top-label span {
          color: #2563ff;
        }

        .visual-coordinate {
          position: absolute;
          right: 0;
          bottom: 30px;
          font-size: 8px;
          color: rgba(17,19,24,.3);
          letter-spacing: .14em;
        }

        .visual-motif {
          position: absolute;
          right: -35px;
          top: 70px;
          color: rgba(37,99,255,.55);
          animation: motifFloat 5s ease-in-out infinite;
        }

        @keyframes motifFloat {
          0%,100% {
            transform: translateY(0) rotate(0deg);
          }
          50% {
            transform: translateY(-12px) rotate(8deg);
          }
        }

        /* EXPERTISE */

        .expertise {
          border-top: 1px solid rgba(17,19,24,.1);
          border-bottom: 1px solid rgba(17,19,24,.1);
          display: grid;
          grid-template-columns: 150px 1fr;
          overflow: hidden;
        }

        .expertise-label {
          display: flex;
          align-items: center;
          padding: 18px 0;
          font-size: 8px;
          letter-spacing: .18em;
          color: rgba(17,19,24,.4);
          border-right: 1px solid rgba(17,19,24,.1);
        }

        .expertise-track-wrapper {
          overflow: hidden;
        }

        .expertise-track {
          display: flex;
          width: max-content;
          animation: expertiseScroll 30s linear infinite;
        }

        .expertise-item {
          display: flex;
          align-items: center;
          gap: 25px;
          padding: 0 28px;
          height: 58px;
          font-size: 9px;
          letter-spacing: .15em;
          color: rgba(17,19,24,.58);
          white-space: nowrap;
        }

        .expertise-item:hover {
          color: #2563ff;
        }

        .tiny-motif {
          color: #2563ff;
          opacity: .55;
        }

        @keyframes expertiseScroll {
          from {
            transform: translateX(0);
          }
          to {
            transform: translateX(-50%);
          }
        }

        /* INTRO */

        .intro {
          position: relative;
          z-index: 1;
          padding: 160px 0;
        }

        .section-index {
          display: flex;
          gap: 18px;
          align-items: center;
          color: rgba(17,19,24,.38);
          font-size: 8px;
          letter-spacing: .18em;
        }

        .section-index span:first-child {
          color: #2563ff;
        }

        .intro-grid {
          display: grid;
          grid-template-columns: 1.25fr .75fr;
          gap: 100px;
          margin-top: 60px;
        }

        .intro h2 {
          margin: 0;
          font-size: clamp(44px, 5.2vw, 78px);
          line-height: .95;
          letter-spacing: -.07em;
          font-weight: 500;
        }

        .intro h2 span {
          display: block;
          color: rgba(17,19,24,.28);
        }

        .intro-grid p {
          margin: 0 0 20px;
          color: rgba(17,19,24,.57);
          font-size: 14px;
          line-height: 1.8;
        }

        .text-link {
          display: flex;
          align-items: center;
          gap: 9px;
          margin-top: 35px;
          border: 0;
          background: transparent;
          padding: 0;
          color: #2563ff;
          font-size: 11px;
          cursor: pointer;
        }

        /* SERVICES */

        .services {
          position: relative;
          z-index: 1;
          padding: 80px 0 160px;
        }

        .section-heading h2 {
          margin: 45px 0 80px;
          font-size: clamp(60px, 7vw, 105px);
          line-height: .85;
          letter-spacing: -.08em;
          font-weight: 500;
        }

        .section-heading h2 span {
          color: #2563ff;
        }

        .service-list {
          border-top: 1px solid rgba(17,19,24,.1);
        }

        .service-row {
          position: relative;
          display: grid;
          grid-template-columns: 70px 55px 1fr 1fr 30px;
          align-items: center;
          gap: 20px;
          min-height: 150px;
          border-bottom: 1px solid rgba(17,19,24,.1);
          transition: .3s ease;
        }

        .service-row:hover {
          padding-left: 15px;
          background: rgba(255,255,255,.55);
        }

        .service-number {
          color: #2563ff;
          font-size: 9px;
          letter-spacing: .12em;
        }

        .service-icon {
          width: 40px;
          height: 40px;
          display: grid;
          place-items: center;
          border: 1px solid rgba(17,19,24,.1);
          color: #2563ff;
          transition: .3s ease;
        }

        .service-row:hover .service-icon {
          background: #2563ff;
          color: white;
          border-color: #2563ff;
          transform: rotate(45deg);
        }

        .service-row h3 {
          margin: 0;
          font-size: 25px;
          font-weight: 500;
          letter-spacing: -.04em;
        }

        .service-row p {
          max-width: 380px;
          margin: 0;
          color: rgba(17,19,24,.48);
          font-size: 12px;
          line-height: 1.7;
        }

        .service-arrow {
          color: rgba(17,19,24,.25);
          transition: .3s ease;
        }

        .service-row:hover .service-arrow {
          color: #2563ff;
          transform: translate(3px,-3px);
        }

        /* IDENTITY */

        .identity {
          position: relative;
          z-index: 1;
          padding: 40px 0 160px;
        }

        .identity-box {
          position: relative;
          min-height: 480px;
          overflow: hidden;
          display: flex;
          align-items: center;
          padding: 70px;
          background: #111318;
          color: white;
        }

        .identity-content {
          position: relative;
          z-index: 2;
          max-width: 700px;
        }

        .identity-small {
          color: #78a0ff;
          font-size: 9px;
          letter-spacing: .2em;
        }

        .identity h2 {
          margin: 25px 0;
          font-size: clamp(58px, 7vw, 105px);
          line-height: .84;
          letter-spacing: -.08em;
          font-weight: 500;
        }

        .identity h2 span {
          color: #78a0ff;
        }

        .identity p {
          max-width: 440px;
          margin: 0;
          color: rgba(255,255,255,.52);
          font-size: 14px;
          line-height: 1.8;
        }

        .identity-pattern {
          position: absolute;
          right: -80px;
          top: -80px;
          display: grid;
          grid-template-columns: repeat(3, 110px);
          gap: 15px;
          color: rgba(255,255,255,.11);
          transform: rotate(10deg);
        }

        .identity-mark {
          position: absolute;
          right: 90px;
          bottom: 50px;
          color: rgba(37,99,255,.6);
        }

        /* WORK */

        .work {
          position: relative;
          z-index: 1;
          padding: 40px 0 160px;
        }

        .work-heading {
          display: flex;
          align-items: end;
          justify-content: space-between;
        }

        .work-heading p {
          max-width: 330px;
          margin: 0;
          color: rgba(17,19,24,.48);
          font-size: 12px;
          line-height: 1.7;
        }

        .work-grid {
          display: grid;
          grid-template-columns: 1.25fr .75fr;
          gap: 20px;
        }

        .work-card {
          overflow: hidden;
          background: white;
          border: 1px solid rgba(17,19,24,.1);
        }

        .work-card-top {
          display: flex;
          justify-content: space-between;
          padding: 16px 18px;
          color: rgba(17,19,24,.4);
          font-size: 8px;
          letter-spacing: .16em;
          border-bottom: 1px solid rgba(17,19,24,.08);
        }

        .work-visual {
          position: relative;
          height: 390px;
          overflow: hidden;
          display: grid;
          place-items: center;
        }

        .work-blue {
          background:
            linear-gradient(
              135deg,
              #2563ff,
              #1d4ed8
            );
        }

        .work-interface {
          width: 70%;
          height: 65%;
          padding: 25px;
          background: rgba(255,255,255,.95);
          box-shadow: 0 30px 60px rgba(0,0,0,.18);
        }

        .work-interface span {
          color: #2563ff;
          font-size: 8px;
        }

        .work-interface strong {
          display: block;
          margin-top: 30px;
          font-size: clamp(26px, 3vw, 50px);
          line-height: .9;
          letter-spacing: -.06em;
          font-weight: 500;
        }

        .interface-line {
          width: 70%;
          height: 1px;
          margin-top: 35px;
          background: #111318;
        }

        .interface-line.short {
          width: 40%;
          margin-top: 10px;
          opacity: .2;
        }

        .work-pattern {
          background: #eceff4;
        }

        .work-pattern .work-motif {
          color: rgba(37,99,255,.5);
          animation: motifFloat 6s ease-in-out infinite;
        }

        .work-pattern > span {
          position: absolute;
          bottom: 25px;
          right: 25px;
          color: rgba(17,19,24,.3);
          font-size: 9px;
          letter-spacing: .18em;
        }

        .work-info {
          padding: 24px 20px 28px;
        }

        .work-info h3 {
          margin: 0 0 7px;
          font-size: 20px;
          font-weight: 500;
          letter-spacing: -.04em;
        }

        .work-info p {
          margin: 0;
          color: rgba(17,19,24,.4);
          font-size: 10px;
        }

        /* CONTACT */

        .contact {
          position: relative;
          z-index: 1;
          padding: 100px 0 40px;
          background: #111318;
          color: white;
        }

        .contact .section-index {
          color: rgba(255,255,255,.35);
        }

        .contact-layout {
          display: grid;
          grid-template-columns: 1fr 1fr;
          align-items: end;
          gap: 80px;
          padding: 120px 0;
        }

        .contact h2 {
          margin: 0;
          font-size: clamp(65px, 8vw, 125px);
          line-height: .83;
          letter-spacing: -.09em;
          font-weight: 500;
        }

        .contact h2 span {
          color: #78a0ff;
        }

        .contact-layout p {
          max-width: 330px;
          margin: 30px 0 0;
          color: rgba(255,255,255,.46);
          font-size: 13px;
          line-height: 1.8;
        }

        .contact-button {
          justify-self: end;
          width: 180px;
          height: 180px;
          border-radius: 50%;
          border: 1px solid rgba(120,160,255,.7);
          background: #2563ff;
          color: white;
          display: flex;
          align-items: center;
          justify-content: center;
          gap: 10px;
          cursor: pointer;
          font-size: 10px;
          transition: .3s ease;
        }

        .contact-button:hover {
          transform: scale(1.06);
          background: white;
          color: #111318;
        }

        .contact-bottom {
          display: flex;
          justify-content: space-between;
          padding-top: 18px;
          border-top: 1px solid rgba(255,255,255,.1);
          color: rgba(255,255,255,.3);
          font-size: 8px;
          letter-spacing: .14em;
          text-transform: uppercase;
        }

        /* RESPONSIVE */

        @media (max-width: 900px) {

          .container,
          .nav-inner,
          .mobile-nav {
            width: min(100% - 30px, 1500px);
          }

          .mobile-menu {
            display: flex;
          }

          .hero {
            padding-top: 110px;
          }

          .hero-layout {
            grid-template-columns: 1fr;
            gap: 30px;
            padding: 70px 0 80px;
          }

          .hero-visual {
            min-height: 400px;
          }

          .intro-grid,
          .work-grid,
          .contact-layout {
            grid-template-columns: 1fr;
          }

          .intro-grid {
            gap: 45px;
          }

          .service-row {
            grid-template-columns: 40px 45px 1fr 30px;
          }

          .service-row p {
            display: none;
          }

          .contact-button {
            justify-self: start;
          }

          .identity-box {
            padding: 50px 35px;
          }

          .identity-mark {
            right: 20px;
            bottom: 20px;
            opacity: .5;
          }

        }

        @media (max-width: 600px) {

          .hero-meta {
            grid-template-columns: 1fr 1fr;
          }

          .hero-meta .meta-center {
            display: none;
          }

          .hero h1 {
            font-size: 18vw;
          }

          .hero-description {
            font-size: 13px;
          }

          .hero-actions {
            flex-direction: column;
            align-items: stretch;
          }

          .primary-button,
          .secondary-button {
            justify-content: center;
          }

          .hero-visual {
            min-height: 340px;
          }

          .visual-motif {
            right: -20px;
            top: 40px;
          }

          .product-main {
            padding: 18px;
          }

          .product-content {
            min-height: 300px;
          }

          .expertise {
            grid-template-columns: 1fr;
          }

          .expertise-label {
            border-right: 0;
            border-bottom: 1px solid rgba(17,19,24,.1);
            padding: 12px 0;
          }

          .expertise-item {
            height: 50px;
          }

          .intro,
          .services,
          .work,
          .identity {
            padding-top: 90px;
            padding-bottom: 90px;
          }

          .service-row {
            grid-template-columns: 35px 40px 1fr 25px;
            gap: 10px;
            min-height: 110px;
          }

          .service-row h3 {
            font-size: 18px;
          }

          .service-icon {
            width: 34px;
            height: 34px;
          }

          .identity-box {
            min-height: 500px;
          }

          .identity-pattern {
            right: -150px;
          }

          .work-heading {
            display: block;
          }

          .work-heading p {
            margin-top: 30px;
          }

          .work-visual {
            height: 300px;
          }

          .contact-layout {
            padding: 90px 0;
          }

          .contact-bottom {
            flex-direction: column;
            gap: 12px;
          }

        }

        @media (prefers-reduced-motion: reduce) {

          *,
          *::before,
          *::after {
            animation-duration: .01ms !important;
            animation-iteration-count: 1 !important;
            scroll-behavior: auto !important;
          }

        }

      `}
      </style>
    </main>
  );
}
