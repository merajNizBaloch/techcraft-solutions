                <span className="h-2 w-2 rounded-full bg-white/15" />
                <span className="h-2 w-2 rounded-full bg-white/15" />
                <span className="h-2 w-2 rounded-full bg-white/15" />

              </div>

              <p>
                <span className="text-[#2563FF]">const</span>{" "}
                experience = {"{"}
              </p>

              <p className="pl-5">
                design:{" "}
                <span className="text-white/65">
                  &quot;human-first&quot;
                </span>,
              </p>

              <p className="pl-5">
                engineering:{" "}
                <span className="text-white/65">
                  &quot;production-ready&quot;
                </span>,
              </p>

              <p className="pl-5">
                intelligence:{" "}
                <span className="text-white/65">
                  &quot;purposeful&quot;
                </span>,
              </p>

              <p className="pl-5">
                craft:{" "}
                <span className="text-[#2563FF]">
                  true
                </span>,
              </p>

              <p>
