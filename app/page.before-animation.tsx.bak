                thoughtful engineering.
              </p>

            </div>

          </div>

        </div>

      </section>

      {/* =====================================================
          TECHNICAL / CODE VISUAL
      ====================================================== */}

      <section className="relative z-10 px-5 py-24 md:px-10 md:py-40">

        <div className="mx-auto max-w-[1600px]">

          <div className="grid gap-12 md:grid-cols-[120px_1fr_1fr]">

            <span className="text-[10px] text-[#2563FF]">
              05
            </span>

            <div>

              <p className="text-[10px] uppercase tracking-[.2em] text-white/25">
