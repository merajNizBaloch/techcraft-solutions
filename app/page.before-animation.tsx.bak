        </div>

      </section>

      {/* =====================================================
          CONTACT
      ====================================================== */}

      <section
        id="contact"
        className="relative z-10 px-5 pb-10 pt-40 md:px-10 md:pb-16 md:pt-60"
      >

        <div className="mx-auto max-w-[1600px]">

          <div className="border-t border-white/10 pt-6">

            <span className="text-[10px] uppercase tracking-[.2em] text-[#2563FF]">
              09 / Start something
            </span>

            <h2 className="mt-16 text-[17vw] font-medium leading-[.68] tracking-[-.105em] md:text-[12vw]">

              HAVE

              <span className="text-white/[.16]">
                {" "}AN
              </span>

              <br />

              <span className="text-[#2563FF]">
                IDEA?
              </span>

            </h2>

            <div className="mt-24 grid gap-10 border-t border-white/10 pt-8 md:grid-cols-2">

              <div>

                <p className="max-w-lg text-sm leading-8 text-white/35 md:text-base">
                  Tell us what you're building, what you're solving,
                  or simply what you're imagining.
                </p>

                <a
                  href="mailto:hello@techcraftsolutions.com"
                  className="mt-7 inline-flex items-center gap-2 text-lg hover:text-[#2563FF]"
                >
                  hello@techcraftsolutions.com
                  <ArrowUpRight size={17} />
                </a>

              </div>

              <div className="flex md:justify-end">

                <button className="group flex h-fit items-center gap-5 rounded-full bg-[#2563FF] px-7 py-4 text-[10px] uppercase tracking-[.18em] transition hover:bg-[#477BFF]">

                  Let's talk

                  <ArrowUpRight
                    size={15}
                    className="transition-transform group-hover:translate-x-1 group-hover:-translate-y-1"
                  />

                </button>

              </div>

            </div>

          </div>

          <footer className="mt-32 flex flex-col justify-between gap-4 border-t border-white/10 pt-6 text-[8px] uppercase tracking-[.2em] text-white/20 md:flex-row">

            <span>
              © {new Date().getFullYear()} TechCraft Solutions
            </span>

            <span>
              Design / Engineering / Intelligence
            </span>

            <span>
              Balochistan / Pakistan
            </span>

          </footer>

        </div>

      </section>

      {/* =====================================================
          GLOBAL CSS
      ====================================================== */}

      <style jsx global>{`

        html {
          scroll-behavior: smooth;
        }

        body {
          margin: 0;
          background: #080808;
        }

        .nav-link {
          font-size: 10px;
          text-transform: uppercase;
          letter-spacing: .18em;
          color: rgba(255,255,255,.35);
          transition: color .3s ease;
        }

        .nav-link:hover {
          color: white;
        }

        @keyframes marqueeLeft {
          from {
            transform: translateX(0);
          }

          to {
            transform: translateX(-50%);
          }
        }

        @keyframes marqueeRight {
          from {
            transform: translateX(-50%);
          }

          to {
            transform: translateX(0);
          }
        }

        .animate-marquee-left {
          animation: marqueeLeft 35s linear infinite;
        }

        .animate-marquee-right {
          animation: marqueeRight 42s linear infinite;
        }

        @media (prefers-reduced-motion: reduce) {
          .animate-marquee-left,
          .animate-marquee-right {
            animation-play-state: paused;
          }

          html {
            scroll-behavior: auto;
          }
        }

      `}</style>

    </main>
  );
}

/* =========================================================
   BALOCHI EMBROIDERY BORDER
========================================================= */

function BalochiBorder() {
  const motifs = Array.from({ length: 30 });

  return (
    <div className="relative z-20 overflow-hidden border-y border-white/10 bg-[#090909]">

      <div className="flex h-[54px] min-w-max items-center">

        {motifs.map((_, index) => (

          <div
            key={index}
            className="relative mx-2 h-9 w-9 shrink-0"
          >

            {/* outer diamond */}

            <div className="absolute inset-1 rotate-45 border border-[#2563FF]/50" />

            {/* inner diamond */}

            <div className="absolute left-2 top-2 h-5 w-5 rotate-45 border border-[#D94B3D]/40" />

            {/* center */}

            <div className="absolute left-1/2 top-1/2 h-2 w-2 -translate-x-1/2 -translate-y-1/2 rotate-45 bg-[#E7B64A]/60" />

          </div>

        ))}

      </div>

    </div>
  );
}

/* =========================================================
   BALOCHI EMBROIDERY ARTWORK
========================================================= */

function BalochiArtwork() {
  return (
    <div className="pointer-events-none absolute inset-0 overflow-hidden">

      {/* left embroidered panel */}

      <div className="absolute -left-20 top-1/2 h-[850px] w-[420px] -translate-y-1/2 -rotate-6 opacity-[0.13]">

        <div className="absolute inset-0 border-[10px] border-[#8D2925]" />

        <div className="absolute inset-5 border-[3px] border-[#D7A72D]" />

        <div className="absolute inset-10 border-[2px] border-[#2563FF]" />

        <div className="absolute inset-[65px]">

          <EmbroideryColumn />

        </div>

      </div>

      {/* right embroidered panel */}

      <div className="absolute -right-20 top-1/2 h-[850px] w-[420px] -translate-y-1/2 rotate-6 opacity-[0.10]">

        <div className="absolute inset-0 border-[10px] border-[#8D2925]" />

        <div className="absolute inset-5 border-[3px] border-[#D7A72D]" />

        <div className="absolute inset-10 border-[2px] border-[#2563FF]" />

        <div className="absolute inset-[65px]">

          <EmbroideryColumn />

        </div>

      </div>

    </div>
  );
}

/* =========================================================
   EMBROIDERY COLUMN
========================================================= */

function EmbroideryColumn() {
  const motifs = Array.from({ length: 7 });

  return (
    <div className="flex h-full flex-col justify-between">

      {motifs.map((_, index) => (

        <div
          key={index}
          className="relative mx-auto h-20 w-20"
        >

          {/* large diamond */}

          <div className="absolute inset-2 rotate-45 border-4 border-[#D13F36]" />

          {/* second diamond */}

          <div className="absolute inset-4 rotate-45 border-2 border-[#D9A82D]" />

          {/* blue diamond */}

          <div className="absolute inset-6 rotate-45 border-2 border-[#2563FF]" />

          {/* star-like center */}

          <div className="absolute left-1/2 top-1/2 h-7 w-7 -translate-x-1/2 -translate-y-1/2 rotate-45 border-2 border-[#F0D96A]" />

          {/* four corner stitches */}

          <span className="absolute left-0 top-1/2 h-2 w-2 -translate-y-1/2 bg-[#2563FF]" />
          <span className="absolute right-0 top-1/2 h-2 w-2 -translate-y-1/2 bg-[#D13F36]" />
          <span className="absolute left-1/2 top-0 h-2 w-2 -translate-x-1/2 bg-[#D9A82D]" />
          <span className="absolute bottom-0 left-1/2 h-2 w-2 -translate-x-1/2 bg-[#D13F36]" />

        </div>

      ))}

    </div>
  );
}
