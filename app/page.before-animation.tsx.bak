              >

                <span>
                  {item}
                </span>

                <span className="text-[#2563FF]">
                  ✦
                </span>

              </div>

            ))}

          </div>

        </div>

        <div className="border-t border-white/10 py-4">

          <div className="flex w-max animate-marquee-right">

            {[...expertise.slice().reverse(), ...expertise.slice().reverse()].map(
              (item, index) => (

                <div
                  key={index}
                  className="mx-8 flex items-center gap-8 whitespace-nowrap text-[clamp(20px,3vw,46px)] font-medium uppercase leading-none tracking-[-.06em] text-white/20"
                >

                  <span>
                    {item}
                  </span>

                  <span>
                    ◆
                  </span>

                </div>

              )
            )}

          </div>

        </div>

      </section>

      {/* =====================================================
          STATEMENT
      ====================================================== */}

      <section className="relative z-10 px-5 py-40 md:px-10 md:py-64">

        <div className="mx-auto max-w-[1600px]">

          <div className="mb-16 grid md:grid-cols-[120px_1fr]">

            <span className="text-[10px] uppercase tracking-[.2em] text-[#2563FF]">
              02
            </span>

            <span className="text-[10px] uppercase tracking-[.2em] text-white/25">
              Why TechCraft
            </span>

          </div>

          <h2 className="max-w-[1450px] text-[12vw] font-medium leading-[.76] tracking-[-.095em] md:text-[9vw]">

            TECHNOLOGY
            <br />

            <span className="text-white/[.16]">
              IS EVERYWHERE.
            </span>

            <br />

            <span>
              EXPERIENCE
            </span>

            <br />

            <span className="text-[#2563FF]">
              ISN'T.
            </span>

          </h2>

          <div className="mt-20 grid gap-10 md:grid-cols-[120px_1fr_1fr]">

            <div />

            <p className="max-w-xl text-sm leading-8 text-white/40 md:text-base">
              Software can function perfectly and still feel wrong.
              We believe the experience is part of the product itself.
            </p>

            <p className="max-w-xl text-sm leading-8 text-white/25 md:text-base">
              That's why design isn't decoration at TechCraft.
              It informs how we understand problems, architect products
              and engineer the technology behind them.
            </p>

          </div>

        </div>

      </section>

      {/* =====================================================
          SERVICES — EDITORIAL NOT CARDS
      ====================================================== */}

      <section
        id="services"
        className="relative z-10 px-5 py-24 md:px-10 md:py-40"
      >

        <div className="mx-auto max-w-[1600px]">

          <div className="grid md:grid-cols-[120px_1fr]">

            <div>
              <span className="text-[10px] text-[#2563FF]">
                03
              </span>
            </div>

            <div>

              <p className="text-[10px] uppercase tracking-[.2em] text-white/25">
