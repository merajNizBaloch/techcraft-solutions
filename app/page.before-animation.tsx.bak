                className="group relative border-t border-white/10 py-12 transition-colors duration-500 hover:border-[#2563FF]/40 md:py-20"
              >

                <div className="grid gap-8 md:grid-cols-[120px_1.1fr_1fr]">

                  <div className="text-[10px] text-[#2563FF]">
                    {service.number}
                  </div>

                  <div>

                    <h3 className="text-[10vw] font-medium leading-[.72] tracking-[-.09em] transition-transform duration-700 group-hover:translate-x-3 md:text-[6.8vw]">

                      {service.title}

                      <span className="block text-[#2563FF]">
                        {service.accent}
                      </span>

                    </h3>

                  </div>

                  <div className="md:pt-4">

                    <p className="max-w-xl text-sm leading-8 text-white/40 md:text-base">
                      {service.description}
                    </p>

                    <p className="mt-10 text-[9px] uppercase tracking-[.2em] text-white/20">
                      {service.capabilities}
                    </p>

                  </div>

                </div>

                {activeService === service.number && (
                  <div className="pointer-events-none absolute right-0 top-1/2 hidden -translate-y-1/2 md:block">
                    <div className="flex h-24 w-24 items-center justify-center rounded-full border border-[#2563FF]/50">
                      <Plus
                        size={18}
                        className="text-[#2563FF]"
                      />
                    </div>
                  </div>
                )}

              </article>

            ))}

            <div className="border-t border-white/10" />

          </div>

        </div>

      </section>

      {/* =====================================================
          DESIGN / ENGINEERING
      ====================================================== */}

      <section className="relative z-10 px-5 py-40 md:px-10 md:py-60">

        <div className="mx-auto max-w-[1600px]">

          <div className="grid md:grid-cols-[120px_1fr]">

            <span className="text-[10px] text-[#2563FF]">
              04
            </span>

            <span className="text-[10px] uppercase tracking-[.2em] text-white/25">
              The TechCraft approach
            </span>

          </div>

          <div className="mt-24 grid border-y border-white/10 md:grid-cols-2">

            <div className="border-b border-white/10 py-20 md:border-b-0 md:border-r md:pr-16">

              <p className="text-[10px] uppercase tracking-[.2em] text-white/25">
                01 / Experience
              </p>

              <h2 className="mt-12 text-[13vw] font-medium leading-[.67] tracking-[-.1em] md:text-[9vw]">

                THINK

                <span className="block text-[#2563FF]">
                  FIRST.
                </span>

              </h2>

              <p className="mt-14 max-w-md text-sm leading-8 text-white/35">
                Research. Strategy. User experience. Interaction.
                We understand what should exist before deciding how
                it should be built.
              </p>

            </div>

            <div className="py-20 md:pl-16">

              <p className="text-[10px] uppercase tracking-[.2em] text-white/25">
                02 / Technology
              </p>

              <h2 className="mt-12 text-[13vw] font-medium leading-[.67] tracking-[-.1em] md:text-[9vw]">

                BUILD

                <span className="block text-[#2563FF]">
                  RIGHT.
                </span>

              </h2>

              <p className="mt-14 max-w-md text-sm leading-8 text-white/35">
