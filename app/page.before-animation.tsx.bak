"use client";

import { useEffect, useRef, useState } from "react";
import {
  ArrowDown,
  ArrowUpRight,
  Menu,
  X,
  Plus,
} from "lucide-react";

/* =========================================================
   DATA
========================================================= */

const expertise = [
  "EXPERIENCE DESIGN",
  "SOFTWARE ENGINEERING",
  "WEB DEVELOPMENT",
  "MOBILE APPLICATIONS",
  "AI & INTELLIGENCE",
  "CLOUD SYSTEMS",
  "AUTOMATION",
  "DIGITAL PRODUCTS",
];

const services = [
  {
    number: "01",
    title: "Experience",
    accent: "Design",
    description:
      "We design digital experiences that make complex products feel simple, useful and human.",
    capabilities: "UX / UI / PRODUCT / INTERACTION / DESIGN SYSTEMS",
  },
  {
    number: "02",
    title: "Software",
    accent: "Engineering",
    description:
      "We engineer scalable software products across web, mobile, backend and enterprise systems.",
    capabilities: "WEB / MOBILE / FULL STACK / API / ARCHITECTURE",
  },
  {
    number: "03",
    title: "Artificial",
    accent: "Intelligence",
    description:
      "We integrate AI, computer vision and automation into products where intelligence creates value.",
    capabilities: "AI / ML / COMPUTER VISION / AUTOMATION",
  },
  {
    number: "04",
    title: "Cloud",
    accent: "Technology",
    description:
      "We build reliable infrastructure and deployment systems that allow products to perform and scale.",
    capabilities: "CLOUD / DATABASE / DEVOPS / SECURITY",
  },
];

const projects = [
  {
    number: "01",
    type: "DIGITAL EXPERIENCE",
    title: "Rehaan & Associates",
    description:
      "A digital experience for a civil engineering firm combining architectural thinking, visual identity and interactive technology.",
  },
  {
    number: "02",
    type: "PRODUCT DESIGN / SOFTWARE",
    title: "WHS Inspection",
    description:
      "A field inspection experience designed to make complex workflows easier to understand, complete and manage.",
  },
  {
    number: "03",
    type: "AI / COMPUTER VISION",
    title: "Date Recognition",
    description:
      "A computer vision system exploring automated recognition through modern machine-learning techniques.",
  },
];

const process = [
  ["01", "DISCOVER", "Understand the problem."],
  ["02", "DESIGN", "Define the experience."],
  ["03", "ENGINEER", "Build the technology."],
  ["04", "DEPLOY", "Take it into production."],
];

/* =========================================================
   PAGE
========================================================= */

export default function Home() {
  const [menuOpen, setMenuOpen] = useState(false);
  const [mouse, setMouse] = useState({ x: 0, y: 0 });
  const [activeService, setActiveService] = useState<string | null>(null);

  const cursorRef = useRef<HTMLDivElement>(null);

  useEffect(() => {
    const handleMove = (event: MouseEvent) => {
      const x = event.clientX;
      const y = event.clientY;

      setMouse({ x, y });

      if (cursorRef.current) {
        cursorRef.current.animate(
          {
            left: `${x}px`,
            top: `${y}px`,
          },
          {
            duration: 350,
            fill: "forwards",
            easing: "cubic-bezier(.22,1,.36,1)",
          }
        );
      }
    };

    window.addEventListener("mousemove", handleMove);

    return () => {
      window.removeEventListener("mousemove", handleMove);
    };
  }, []);

  const scrollTo = (id: string) => {
    document.getElementById(id)?.scrollIntoView({
      behavior: "smooth",
    });

    setMenuOpen(false);
  };

  return (
    <main className="relative min-h-screen overflow-hidden bg-[#080808] text-[#F5F4EF]">


      {/* =====================================================
          ATMOSPHERIC BACKGROUND
      ====================================================== */}

      <div className="pointer-events-none fixed inset-0 z-0">

        {/* blue mouse glow */}
        <div
          className="absolute h-[600px] w-[600px] rounded-full blur-[150px]"
          style={{
            left: mouse.x - 300,
            top: mouse.y - 300,
            background: "rgba(37,99,255,.075)",
          }}
        />

        {/* very subtle grid */}
        <div
          className="absolute inset-0 opacity-[0.018]"
          style={{
            backgroundImage:
              "linear-gradient(rgba(255,255,255,.8) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.8) 1px, transparent 1px)",
            backgroundSize: "80px 80px",
          }}
        />

        <div className="absolute inset-0 bg-[radial-gradient(circle_at_center,transparent_0%,#080808_85%)]" />
      </div>

      {/* =====================================================
          CURSOR
      ====================================================== */}

      <div
        ref={cursorRef}
        className="pointer-events-none fixed left-0 top-0 z-[100] hidden h-8 w-8 -translate-x-1/2 -translate-y-1/2 rounded-full border border-[#2563FF]/60 md:block"
      >
        <div className="absolute left-1/2 top-1/2 h-1 w-1 -translate-x-1/2 -translate-y-1/2 rounded-full bg-[#2563FF] shadow-[0_0_20px_#2563FF]" />
      </div>

      {/* =====================================================
          NAVIGATION
      ====================================================== */}

      <header className="fixed left-0 right-0 top-0 z-50">
        <nav className="mx-auto flex max-w-[1600px] items-center justify-between px-5 py-6 md:px-10">

          <button
            onClick={() => scrollTo("home")}
            className="text-sm font-semibold tracking-[-0.05em]"
          >
            TECH<span className="text-[#2563FF]">CRAFT</span>
          </button>

          <div className="hidden items-center gap-8 md:flex">

            <button
              onClick={() => scrollTo("services")}
              className="nav-link"
            >
              Services
            </button>

            <button
              onClick={() => scrollTo("work")}
              className="nav-link"
            >
              Work
            </button>

            <button
              onClick={() => scrollTo("about")}
              className="nav-link"
            >
              About
            </button>

            <button
              onClick={() => scrollTo("contact")}
              className="rounded-full bg-[#2563FF] px-5 py-2.5 text-[10px] uppercase tracking-[.15em] transition hover:bg-[#477BFF]"
            >
              Start a project
            </button>

          </div>

          <button
            onClick={() => setMenuOpen(!menuOpen)}
            className="rounded-full border border-white/10 p-2 md:hidden"
          >
            {menuOpen ? <X size={17} /> : <Menu size={17} />}
          </button>
        </nav>

        {menuOpen && (
          <div className="mx-4 rounded-2xl border border-white/10 bg-[#0B0B0B]/95 p-6 backdrop-blur-xl md:hidden">

            <div className="flex flex-col gap-6">

              {[
                ["services", "Services"],
                ["work", "Work"],
                ["about", "About"],
                ["contact", "Contact"],
              ].map(([id, name]) => (
                <button
                  key={id}
                  onClick={() => scrollTo(id)}
                  className="text-left text-xs uppercase tracking-[.2em] text-white/60"
                >
                  {name}
                </button>
              ))}

            </div>
          </div>
        )}
      </header>

      {/* =====================================================
          HERO
      ====================================================== */}

      <section
        id="home"
        className="relative z-10 min-h-screen px-5 pt-32 md:px-10"
      >

        <div className="mx-auto flex min-h-screen max-w-[1600px] flex-col justify-between pb-8">

          {/* top metadata */}

          <div className="grid grid-cols-2 border-b border-white/10 pb-4 text-[9px] uppercase tracking-[.2em] text-white/30 md:grid-cols-4">

            <span>TechCraft Solutions</span>

            <span className="hidden md:block">
              Software House
            </span>

            <span className="hidden md:block">
              Design × Engineering
            </span>

            <span className="text-right">
              01 / 08
            </span>

          </div>

          {/* main hero */}

          <div className="relative py-24 md:py-32">

            <div className="mb-10 text-[10px] uppercase tracking-[.25em] text-[#2563FF]">
              / We design experiences
            </div>

            <h1 className="max-w-[1450px] text-[17vw] font-medium leading-[.72] tracking-[-.105em] md:text-[12vw]">

              <span className="block">
                WE DESIGN
              </span>

              <span className="block">
                <span className="text-[#2563FF]">DIGITAL</span>
              </span>

              <span className="block text-white/[.17]">
                EXPERIENCES.
              </span>

            </h1>

            {/* right-side editorial information */}

            <div className="mt-16 grid gap-10 md:absolute md:bottom-5 md:right-0 md:mt-0 md:w-[350px]">

              <p className="text-sm leading-7 text-white/45">
                TechCraft is a full-fledged software house creating digital
                products through the intersection of experience design,
                software engineering and emerging technology.
              </p>

              <button
                onClick={() => scrollTo("services")}
                className="group flex items-center gap-4 text-[9px] uppercase tracking-[.2em] text-white/40"
              >
                Explore TechCraft

                <span className="flex h-10 w-10 items-center justify-center rounded-full border border-white/10 transition group-hover:border-[#2563FF] group-hover:bg-[#2563FF]">
                  <ArrowDown size={14} />
                </span>
              </button>

            </div>

          </div>

          {/* bottom line */}

          <div className="flex justify-between border-t border-white/10 pt-4 text-[9px] uppercase tracking-[.2em] text-white/25">

            <span>
              Balochistan / Pakistan
            </span>

            <span>
              Design / Engineering / Intelligence
            </span>

          </div>

        </div>
      </section>

      {/* =====================================================
          BALOCHI EMBROIDERY BORDER
      ====================================================== */}

      <BalochiBorder />

      {/* =====================================================
          EXPERTISE MARQUEE
      ====================================================== */}

      <section className="relative z-10 overflow-hidden border-b border-white/10">

        <div className="py-4">

          <div className="flex w-max animate-marquee-left">

            {[...expertise, ...expertise].map((item, index) => (

              <div
                key={index}
